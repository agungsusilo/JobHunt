# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase Dashboard: Project Settings -> API.

# Safe to expose in the browser bundle (must keep the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER prefix this with NEXT_PUBLIC_ and never commit it — it bypasses Row
# Level Security. Only used by scripts/import-jobs.mjs, never in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
